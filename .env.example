# Glyph Music configuration. Copy to ".env" (setup.bat does this for you).
# The real .env is git-ignored. Never commit it.

# ---- Access code ----------------------------------------------------------
# Leave this EMPTY. You create your access code on the website the first time
# you open it; after that it cannot be set again from the website. Only a salted
# hash is stored (in the local database). To replace it, run reset-code.bat.
# Optional override: put a code here (8+ characters) to fix it in this file
# instead, which also switches off the website's first-run setup.
ADMIN_ACCESS_CODE=

# ---- Required -------------------------------------------------------------
# 32+ random characters used to sign session cookies and download links.
SESSION_SECRET=
# Days you stay signed in on a device.
SESSION_EXPIRY_DAYS=7

# ---- Backend (Python, runs on your PC) -------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8787
# Where the frontend reaches the backend. Local mode: leave as is.
# On Vercel, set BACKEND_URL in the Vercel dashboard to your HTTPS tunnel URL.
BACKEND_URL=http://127.0.0.1:8787
# Browser origins allowed to call the backend (comma separated).
# Vercel mode: add your site, e.g. https://glyph-music.vercel.app
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Vercel mode only ------------------------------------------------------
# Public HTTPS address of your tunnel. When set, ZIP downloads use short-lived
# signed links straight to your PC instead of passing through Vercel.
PUBLIC_BACKEND_URL=
# true when the backend sits behind your HTTPS tunnel (trusts X-Forwarded-For).
TRUST_PROXY=false
# auto = Secure cookies whenever the request arrived over HTTPS.
COOKIE_SECURE=auto

# ---- Limits ----------------------------------------------------------------
MAX_PLAYLIST_TRACKS=1000
MAX_SOURCE_FILE_MB=400
MAX_JOB_GB=20
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# ---- Optional --------------------------------------------------------------
# Database, temp files and (by default) downloads live here.
# DATA_DIR=C:\GlyphMusic\data
# Use a specific FFmpeg instead of the bundled one.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
